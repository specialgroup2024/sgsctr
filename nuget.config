<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins the only package source used by CI/Docker builds. Keeping this explicit
  avoids machine-local sources leaking into restores. If api.nuget.org is
  unreachable from your network, mirror the feed locally or route builds
  through a proxy (see .ai/delivery/local-development.md).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
