POSTGRES_DB=sgsctr_dev
POSTGRES_USER=sgsctr
POSTGRES_PASSWORD=replace_with_a_strong_local_password

# pgAdmin local login
PGADMIN_DEFAULT_EMAIL=specialgroup2024@gmail.com
PGADMIN_DEFAULT_PASSWORD=replace_with_a_strong_local_password

# Native SGSCTR application administrator bootstrap.
# Created on API startup only when the email does not already exist.
# Existing account passwords and roles are never overwritten.
BOOTSTRAP_ADMIN_EMAIL=specialgroup2024@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters

# Local-only temporary access mode. Keep false only for localhost development.
# Set true to enforce Identity sign-in and authorization policies.
AUTHENTICATION_ENABLED=false

# Next.js BFF encrypted HttpOnly session cookie. Generate: openssl rand -base64 48
AUTH_SESSION_SECRET=replace_with_output_from_openssl_rand_base64_48

# LAN access: bind only the web UI to the VM's network interfaces.
# Use the exact URL clients will browse; this Origin is checked by BFF write/auth routes.
WEB_BIND_ADDRESS=0.0.0.0
WEB_HOST_PORT=3000
WEB_BASE_URL=http://localhost:3000
# For LAN use, replace localhost with the VM's actual LAN IP, e.g. http://192.168.88.72:3000.
COOKIE_SECURE=false

# Leave empty until the owner explicitly authorizes an organization manager.
# Use the identity subject/user ID of an approved account.
ORGANIZATION_MANAGER_SUBJECTS=
